{
  "name": "ITables development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "options": [
      "--platform=linux/amd64"
    ]
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${devcontainerId}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume"
  ],
  "postCreateCommand": "sudo chown vscode:vscode .pixi && pixi install --locked && pixi run pre-commit install && pixi run python -m ipykernel install --name itables --user",
  "waitFor": "postCreateCommand",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.pixi/envs/default/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [
    8888
  ],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-pyright.pyright",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        }
      }
    }
  },
  "runArgs": [
    "--platform=linux/amd64"
  ]
}
